{
  "manifest_version": 3,
  "name": "Train Ticket Automation",
  "version": "1.0.0",
  "description": "Fills Bangladesh Railway e-ticket search, train, coach, and seats at a scheduled time, then stops at OTP.",
  "permissions": ["storage", "alarms", "scripting", "activeTab", "windows"],
  "host_permissions": ["https://eticket.railway.gov.bd/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Train Ticket Automation",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://eticket.railway.gov.bd/*"],
      "run_at": "document_idle",
      "js": ["utils/selectors.js", "content.js"]
    }
  ]
}
